{
  "name": "smart-doc-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Smart document MVP monorepo",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/shared --filter ./apps/api --filter ./apps/worker --filter ./apps/web build",
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/worker --filter ./apps/web dev",
    "dev:api": "pnpm --filter @smart-doc/api dev",
    "dev:worker": "pnpm --filter @smart-doc/worker dev",
    "dev:web": "pnpm --filter @smart-doc/web dev",
    "dev:parser": "uvicorn app.main:app --app-dir services/parser --host 0.0.0.0 --port 8000",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "prisma:generate": "pnpm --filter @smart-doc/api prisma:generate",
    "prisma:push": "pnpm --filter @smart-doc/api prisma:push"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
