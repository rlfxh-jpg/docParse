generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum WorkspaceRole {
  owner
  editor
  viewer
}

enum DocumentVisibility {
  private
  workspace
  shared
}

enum SourceType {
  upload_pdf
  upload_docx
  upload_md
  web_crawl
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum QaRole {
  USER
  ASSISTANT
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String?
  name          String
  status        UserStatus         @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  ownedWorkspaces Workspace[]      @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  createdDocuments Document[]      @relation("DocumentCreator")
  createdVersions  DocumentVersion[] @relation("VersionCreator")
  documentShares   DocumentShare[]
  qaSessions       QaSession[]
  auditLogs        AuditLog[]
}

model Workspace {
  id         String           @id @default(uuid())
  name       String
  ownerId    String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  owner      User             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    WorkspaceMember[]
  folders    Folder[]
  documents  Document[]
  chunks     DocumentChunk[]
  ingestionJobs IngestionJob[]
  crawlJobs  CrawlJob[]
  qaSessions QaSession[]
  auditLogs  AuditLog[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Folder {
  id          String       @id @default(uuid())
  workspaceId String
  parentId    String?
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[]     @relation("FolderTree")
  documents   Document[]

  @@index([workspaceId])
}

model Document {
  id                String              @id @default(uuid())
  workspaceId       String
  folderId          String?
  createdById       String
  title             String
  content           String?
  visibility        DocumentVisibility  @default(private)
  searchKeywords    String[]            @default([])
  currentVersionId  String?             @unique
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder            Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy         User                @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion    DocumentVersion?    @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]   @relation("DocumentVersions")
  shares            DocumentShare[]
  chunks            DocumentChunk[]
  aiMeta            DocumentAiMeta?
  ingestionJobs     IngestionJob[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([folderId])
}

model DocumentVersion {
  id           String       @id @default(uuid())
  documentId   String
  createdById  String
  sourceType   SourceType
  objectKey    String?
  mimeType     String?
  sizeBytes    Int?
  checksum     String?
  rawText      String?
  createdAt    DateTime     @default(now())

  document     Document     @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("VersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentFor   Document?    @relation("CurrentDocumentVersion")
  chunks       DocumentChunk[]

  @@index([documentId, createdAt(sort: Desc)])
}

model DocumentShare {
  id          String      @id @default(uuid())
  documentId  String
  userId      String
  createdAt   DateTime    @default(now())

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

model DocumentChunk {
  id            String      @id
  documentId    String
  versionId     String
  workspaceId   String
  headingPath   String[]    @default([])
  content       String
  tokenEstimate Int
  page          Int?
  url           String?
  embedding     Unsupported("vector(1024)")?
  embeddingJson Json?
  tsv           Unsupported("tsvector")?
  createdAt     DateTime    @default(now())

  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
}

model IngestionJob {
  id            String      @id @default(uuid())
  workspaceId   String
  documentId    String?
  status        JobStatus   @default(PENDING)
  payload       Json
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([documentId])
}

model CrawlJob {
  id            String      @id @default(uuid())
  workspaceId   String
  requestedById String
  seedUrl       String
  depth         Int         @default(1)
  maxPages      Int         @default(5)
  status        JobStatus   @default(PENDING)
  pagesCrawled  Int         @default(0)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model DocumentAiMeta {
  id            String      @id @default(uuid())
  documentId    String      @unique
  summary       String
  labels        String[]    @default([])
  keywords      String[]    @default([])
  updatedAt     DateTime    @updatedAt

  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model QaSession {
  id            String      @id @default(uuid())
  workspaceId   String
  userId        String
  query         String
  createdAt     DateTime    @default(now())

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      QaMessage[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId])
}

model QaMessage {
  id            String      @id @default(uuid())
  sessionId     String
  role          QaRole
  content       String
  confidence    Float?
  citations     Json?
  createdAt     DateTime    @default(now())

  session       QaSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model AuditLog {
  id            String      @id @default(uuid())
  workspaceId   String
  userId        String?
  action        String
  targetType    String
  targetId      String
  details       Json?
  createdAt     DateTime    @default(now())

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
}
