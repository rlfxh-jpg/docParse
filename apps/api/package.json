{
  "name": "@smart-doc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "echo 'lint not configured yet'",
    "test": "echo 'tests to be added'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo 'format handled by workspace tooling'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:setup": "prisma db execute --schema prisma/schema.prisma --file prisma/setup-extensions.sql",
    "prisma:push": "pnpm run prisma:setup && prisma db push"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.11",
    "@prisma/client": "^6.4.1",
    "@smart-doc/shared": "workspace:*",
    "@sentry/node": "^8.52.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.5.0",
    "ioredis": "^5.4.2",
    "openai": "^4.83.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "tsc-watch": "^6.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
