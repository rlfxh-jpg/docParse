# Shared defaults
NODE_ENV=development
TZ=Asia/Shanghai

# Database
DATABASE_URL=postgresql://smart_doc:smart_doc@localhost:5432/smart_doc?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=smart-documents
S3_FORCE_PATH_STYLE=true

# API auth
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# LLM / embeddings (OpenAI-compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_me
CHAT_MODEL=qwen-plus-latest
EMBEDDING_MODEL=text-embedding-v3

# Parser service
PARSER_SERVICE_URL=http://localhost:8000

# Sentry and observability
SENTRY_DSN=
PROMETHEUS_PORT=9464
